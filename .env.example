# === REQUIRED ===

# Apify API token (free account: https://console.apify.com)
APIFY_TOKEN=apify_api_XXXXXXX

# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic

# LLM API Key (one of these, depending on LLM_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-XXXXXXX
# OPENAI_API_KEY=sk-XXXXXXX

# === OPTIONAL (defaults shown) ===

# ChromaDB
CHROMA_HOST=gse-chroma
CHROMA_PORT=8000

# Embedding model (local or openai)
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pipeline schedule (for --schedule mode)
BULLETIN_POLL_HOURS=6
GUIDE_REFRESH_DAYS=7

# Agent
AGENT_PORT=8000

# Frontend
NEXT_PUBLIC_AGENT_URL=http://localhost:8000
